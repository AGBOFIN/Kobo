{
  "name": "kobo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:prod": "prisma generate --schema prisma/schema.postgres.prisma && prisma migrate deploy --schema prisma/schema.postgres.prisma && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:security": "tsx scripts/test-security-static.ts",
    "seed": "tsx prisma/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "reset-admin-password": "tsx scripts/reset-admin-password.ts",
    "db:dev": "prisma db push",
    "db:migrate": "prisma migrate dev --schema prisma/schema.postgres.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "db:studio": "prisma studio",
    "vercel-build": "prisma generate --schema prisma/schema.postgres.prisma && prisma migrate deploy --schema prisma/schema.postgres.prisma && next build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "next-pwa": "^5.6.0",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jest": "^30.5.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
