# Database
# Développement local (SQLite, schéma prisma/schema.prisma) :
DATABASE_URL="file:./dev.db"
#
# PRODUCTION (Vercel + Neon ou Supabase) — définir dans les variables d'environnement Vercel :
#   DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"   (URL « pooled » recommandée sur Neon)
#   → le schéma production est prisma/schema.postgres.prisma (migrations versionnées,
#     appliquées automatiquement au build via vercel.json)

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Application
APP_NAME="KOBO"
APP_URL="http://localhost:3000"

# Paiement Chariow (si CHARIOW_API_KEY est vide, le mode manuel avec confirmation admin est utilisé)
# Doc développeurs : https://chariow.dev — clé API : app.chariow.com → Settings → API Keys
# CHARIOW_API_KEY=""            # clé API (Bearer) de la boutique Chariow Kobo
# CHARIOW_PULSE_SECRET="whsec_..."  # secret de signature du Pulse (Automations → Pulses → Signing secret)
# CHARIOW_ENV="sandbox"         # "sandbox" en développement, "live" en production (indicatif)
# CHARIOW_API_URL=""            # optionnel : surcharge l'URL de base (défaut : https://api.chariow.com/v1)
#
# IMPORTANT : Chariow est une plateforme de vente de produits numériques. Le prix est
# porté par le PRODUIT côté Chariow (l'API checkout ne prend pas de montant).
# Créez un produit Chariow par pack de crédits (type licence/téléchargeable ré-achetable),
# puis renseignez son ID public (prd_...) sur le pack :
#   CreditPack.chariowProductId = "prd_abc123"
# Webhook : créez un Pulse (Automations → Pulses) pointant vers
#   https://<votre-domaine>/api/credits/webhook/chariow
#   événements : successful.sale, failed.sale, abandoned.sale

# Storage (S3-compatible for production)
# Pour le développement, on utilisera le stockage local
# S3_ENDPOINT=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_BUCKET=""
# S3_REGION=""

# Payment providers (future)
# FLOOZ_API_KEY=""
# FLOOZ_API_SECRET=""
# TMONEY_API_KEY=""
# TMONEY_API_SECRET=""